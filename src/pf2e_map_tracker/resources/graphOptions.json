{
  "interaction": {
    "zoomView": true,
    "dragView": true,
    "keyboard": true,
    "hover": true,
    "hideEdgesOnDrag": false,
    "hideNodesOnDrag": false,
    "tooltipDelay": 999999
  },
  "nodes": {
    "shape": "box",
    "margin": 12,
    "scaling": {
      "min": 25,
      "max": 50
    }
  },
  "edges": {
    "arrows": {
      "to": {
        "scaleFactor": 0.6
      },
      "from": {
        "scaleFactor": 0.6
      }
    },
    "smooth": {
      "type": "continuous"
    }
  }
}
